      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompakt, tek satırlık küçük bir çentik açar: çalan müzik, hava durumu, işler ve pil. Hepsini görmek için herhangi birine tıklayın."
          }
        }
      }
    },
