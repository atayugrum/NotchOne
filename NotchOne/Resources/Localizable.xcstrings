{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "shouldTranslate": false
    },
    "%@ %@": {
      "shouldTranslate": false
    },
    "%@ and %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ and %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ve %2$@"
          }
        }
      }
    },
    "%@ battery is low: %lld%%": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ battery is low: %2$lld%%"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pili azaldı: %%%2$lld"
