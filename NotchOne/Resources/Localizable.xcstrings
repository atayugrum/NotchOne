    "NotchOne %@ is available": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchOne %@ hazır"
          }
        }
      }
    },
    "NotchOne %@ is available. Settings → About": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchOne %@ hazır. Ayarlar → Hakkında"
          }
        }
      }
    },
    "NotchOne asks for nothing until you press a button here. Each one is only for the feature next to it; skip any, and turn them on later in Settings → Privacy.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchOne siz buradaki bir düğmeye basana kadar hiçbir izin istemez. Her biri yalnızca yanındaki özellik içindir; istediğinizi atlayın, sonra Ayarlar → Gizlilik'ten açın."
          }
        }
      }
    },
    "NotchOne couldn't replace itself. Download the update from the website instead.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchOne kendini güncelleyemedi. Güncellemeyi web sitesinden indirin."
          }
        }
      }
    },
    "NotchOne doesn't have camera access.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchOne'un kamera erişimi yok."
          }
        }
      }
    },
