      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Denetleniyor…"
          }
        }
      }
    },
    "Checks for a new version once a day. An update is installed only if it's signed by NotchOne's developer.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde bir kez yeni sürüm olup olmadığına bakar. Güncelleme yalnızca NotchOne'ın geliştiricisi tarafından imzalanmışsa yüklenir."
          }
        }
