      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchOne'ın sunucusu, hesabı, analitiği ve üçüncü taraf kodu yok. Gönderdiği ve sakladığı her şey burada."
          }
        }
      }
    },
