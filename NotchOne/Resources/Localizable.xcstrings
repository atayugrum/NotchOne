        }
      }
    },
    "%@ free": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ boş"
          }
        }
      }
    },
    "%@ need to be downloaded once for on-device translation.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazda çeviri için %@ bir kez indirilmeli."
          }
        }
      }
    },
    "%@ to %@ can't be translated on this Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ to %2$@ can't be translated on this Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ → %2$@ çevirisi bu Mac'te yapılamıyor."
